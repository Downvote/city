				"I packed an umbrella and two coats today, just in case.",
				"What if I'm late tomorrow? I'll leave an hour early.",
			},
			hmm = {
				"W-what do you think it means? Is it bad?",
				"C-can I ask someone else first?",
				"I don't know, and now I'm worried, is that bad?",
				"Can I think about it? Sorry.",
				"Oh no, I hadn't even thought about that.",
			},
			excited = {
				"R-really? You mean it's actually happening?",
				"Oh, that's good, it's really good, isn't it?",
				"{player}, it went fine, and nobody fell over!",
				"I'm shaking, but I think it's happy shaking.",
				"Oh, thank goodness, that's the best news!",
				"I'm going to the festival this year, and I'm only a little scared!",
			},
			tired = {
				"Worrying all day is really hard work.",
				"I checked the oven six times today.",
				"{player}, I'm going to lie down for a bit, but don't worry.",
				"Nothing went wrong today, and I'm still worn out.",
				"My knees are wobbly, from relief, I think.",
			},
			laugh = {
				"Haha, phew, that's funny.",
				"Ahaha, sorry, that's my nervous laugh.",
				"Ha, oh good, it was a joke.",
				"Haha, okay, that helped.",
				"Ha, sorry, is it okay that I laughed?",
			},
		},
	},
}

local byId: { [string]: Personality } = {}
for _, p in Personalities.list do
	byId[p.id] = p
end

function Personalities.get(id: string): Personality?
	return byId[id]
end

function Personalities.trait(id: string, trait: string): number
	local p = byId[id]
	if not p then
		return 0.5
	end
	return p.traits[trait] or 0.5
end

return Personalities
